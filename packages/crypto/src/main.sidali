// sidali-crypto — prime tests, modular arithmetic, and checksums in SidAli.

// Trial division up to isqrt(n): exact, no floating point.
fn isPrime(n) {
  if n < 2 { return false }
  if n == 2 { return true }
  if n % 2 == 0 { return false }
  let d = 3
  while d <= isqrt(n) {
    if n % d == 0 { return false }
    d = d + 2
  }
  return true
}

fn modPow(base, exp, m) {
  let r = 1
  let b = base % m
  let e = exp
  while e > 0 {
    if e % 2 == 1 { r = (r * b) % m }
    b = (b * b) % m
    e = e / 2
  }
  return r
}

// Fermat witness test: false means definitely composite.
fn fermat(n, a) {
  if n < 2 { return false }
  return modPow(a, n - 1, n) == 1
}

// Count the primes in [2, n] by trial division.
fn countPrimes(n) {
  let c = 0
  let i = 2
  while i <= n {
    if isPrime(i) { c = c + 1 }
    i = i + 1
  }
  return c
}

// djb2-style rolling checksum over the first len bytes of a buffer.
fn checksum16(buf: [i64; 16], n: i64) -> i64 {
  let h = 5381
  let i = 0
  while i < n {
    h = ((h * 33) + buf[i]) % 4294967296
    i = i + 1
  }
  return h
}
