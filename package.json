{
  "name": "sidali",
  "version": "1.0.0",
  "private": true,
  "description": "SidAli — a real programming language (compiler + stack VM + playground). Formerly VOID-0.",
  "type": "module",
  "bin": {
    "sidac": "bin/sidac.mjs",
    "sidali": "bin/sidali.mjs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 12000",
    "build": "node build.mjs",
    "build:single": "node build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 12000",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sidac": "node bin/sidac.mjs",
    "sidali": "node bin/sidali.mjs",
    "dist": "node dist-build.mjs",
    "build:dist": "node build.mjs && node dist-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
